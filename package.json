{
  "name": "@alexischarp/slides",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "new:deck": "node scripts/new-deck.mjs"
  },
  "packageManager": "pnpm@11.8.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.8.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "eslint": "^10.5.0",
    "playwright-chromium": "^1.61.0",
    "prettier": "^3.8.4",
    "prettier-plugin-slidev": "^1.0.5",
    "turbo": "^2.9.18"
  }
}
